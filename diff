+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Paged KV views and per-step batch tensors for CPU paged attention."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import torch
+
+from vllm.shadow.executor.kv_manager import ShadowKvManager
+
+
+@dataclass(slots=True)
+class ShadowPagedAttentionBatch:
+    """Batch metadata for CPU paged attention (unified decode + prefill).
+
+    ``slot_mapping`` has length ``sum(query_lens)`` in request order (same token
+    order as the flattened hidden states / QKV tensors).  ``seq_lens`` has length
+    ``len(request_indices)`` — the CPU kernel indexes KV length and block tables
+    **per request**, not per token.
+    """
+
+    block_table: torch.Tensor
+    slot_mapping: torch.Tensor
+    seq_lens: torch.Tensor
+    query_start_loc: torch.Tensor
+    max_seq_len: int
+
+
+class ShadowCpuPagedKvAccessor:
+    """Builds block tables and slot mappings pointing at layer KV caches."""
+
+    __slots__ = ("_kv",)
+
+    def __init__(self, kv: ShadowKvManager) -> None:
+        self._kv = kv
+
+    def layer_kv_caches(self, layer_idx: int) -> tuple[torch.Tensor, torch.Tensor]:
+        """K/V per layer, shape ``[num_blocks, num_kv_heads, block_size, head_dim]``.
+
+        **K** uses the packed tile layout from ``gather_kv_blocks`` /
+        ``cpu_attn_reshape_and_cache``; **V** is row-major ``(slot, dim)`` in the
+        last two axes (HND / flash-style).
+        """
+        mem = self._kv.layer_tensor(layer_idx).tensor
+        if mem.dim() != 5 or mem.size(0) != 2:
+            raise ValueError("expected layer KV shape [2, num_blocks, ...]")
+        k = mem[0]
+        v = mem[1]
+        if not k.is_contiguous():
+            k = k.contiguous()
+            v = v.contiguous()
+        return k, v
+
+    def build_attention_batch(
+        self,
+        batch_req_indices: list[int],
+        query_lens: list[int],
+    ) -> ShadowPagedAttentionBatch:
+        """Build unified batch metadata for ``query_lens`` new tokens per request.
+
+        Decode is the special case where every entry in *query_lens* is 1.
+        """
+        if not batch_req_indices:
+            raise ValueError("empty batch")
+        if len(batch_req_indices) != len(query_lens):
+            raise ValueError("batch_req_indices and query_lens length mismatch")
+        if any(L <= 0 for L in query_lens):
+            raise ValueError("query_lens must be positive")
+
+        handoff = self._kv.handoff
+        block_size = int(handoff.block_size)
+        tables = self._kv.block_tables
+        num_computed = self._kv.num_computed
+
+        n = len(batch_req_indices)
+        max_blocks = max(len(tables[ri]) for ri in batch_req_indices)
+        block_table = torch.zeros((n, max_blocks), dtype=torch.int32)
+
+        total_tokens = sum(query_lens)
+        slot_mapping = torch.empty((total_tokens,), dtype=torch.int64)
+        seq_after: list[int] = []
+        sm = 0
+        for row, (ri, L) in enumerate(zip(batch_req_indices, query_lens, strict=True)):
+            blks = tables[ri]
+            nb = len(blks)
+            if nb > max_blocks:
+                raise RuntimeError("internal: max_blocks too small")
+            block_table[row, :nb] = torch.tensor(blks, dtype=torch.int32)
+            start = int(num_computed[ri])
+            seq_after.append(start + L)
+            for j in range(L):
+                pos = start + j
+                logical_block = pos // block_size
+                if logical_block >= len(blks):
+                    raise RuntimeError(
+                        "block table too short for position "
+                        f"(req={ri} pos={pos} logical_block={logical_block})"
+                    )
+                phys = int(blks[logical_block])
+                slot_mapping[sm + j] = phys * block_size + (pos % block_size)
+            sm += L
+
+        seq_lens = torch.tensor(seq_after, dtype=torch.int32)
+        lens_t = torch.tensor(query_lens, dtype=torch.int32)
+        qsl = torch.zeros((n + 1,), dtype=torch.int32)
+        qsl[1:] = torch.cumsum(lens_t, dim=0)
+        max_seq = int(seq_lens.max().item())
+        return ShadowPagedAttentionBatch(
+            block_table=block_table,
+            slot_mapping=slot_mapping,
+            seq_lens=seq_lens,
+            query_start_loc=qsl,
+            max_seq_len=max_seq,
+        )
