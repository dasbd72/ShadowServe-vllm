+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU shadow executor: autoregressive decode + TKCTH.
+
+Decode: for each output token, run layers 0..L-1 in order; after layer L-1,
+sample the next token and advance to the next step.
+
+Weights are loaded eagerly by :class:`~vllm.shadow.engine.engine.ShadowEngine`
+before the first migration arrives.
+
+KV is expected to be fully received before constructing this executor and must
+be passed via ``layer_kv_tensors``. This executor does not support registering
+KV incrementally.
+
+Call :meth:`start` to begin the decode thread, then :meth:`join`.
+"""
+
+from __future__ import annotations
+
+import logging
+import threading
+import time
+from contextlib import suppress
+
+from vllm.shadow.executor.kv_manager import ShadowKvManager
+from vllm.shadow.models.model_runner import ShadowModelRunner
+from vllm.shadow.models.paged_kv import ShadowCpuPagedKvAccessor
+from vllm.shadow.models.sampling import (
+    ShadowSamplingParams,
+    sampling_params_from_wire_dict,
+)
+from vllm.shadow.transfer.kvhtc_memfd import MemfdTensor
+from vllm.shadow.transfer.kvhtc_protocol import HandoffRequest, MigrationHandoff
+from vllm.shadow.transfer.tkcth_protocol import TkcthFinish, TkcthTokenDelta
+from vllm.shadow.transfer.tkcth_uds import UdsTkcthSenderTransport
+
+logger = logging.getLogger("vllm.shadow.executor.executor")
+
+_DEFAULT_MAX_TOKENS_WHEN_MISSING = 16
+
+_DECODE_JOIN_TIMEOUT_S = 300.0
+
+__all__ = ("ShadowExecutor",)
+
+
+def _max_decode_budget(hr: HandoffRequest) -> int:
+    raw = hr.sampling_params.get("max_tokens")
+    if raw is None:
+        return _DEFAULT_MAX_TOKENS_WHEN_MISSING
+    return max(0, int(raw))
+
+
+def _remaining_new_tokens(hr: HandoffRequest, output_tail: list[int]) -> int:
+    return max(0, _max_decode_budget(hr) - len(output_tail))
+
+
+class ShadowExecutor:
+    """CPU-side shadow executor: decode thread + KV from caller.
+
+    The ``runner`` must already have weights loaded (see
+    :meth:`ShadowModelRunner.load_from_dir`).
+    """
+
+    def __init__(
+        self,
+        handoff: MigrationHandoff,
+        runner: ShadowModelRunner,
+        layer_kv_tensors: list[MemfdTensor],
+    ) -> None:
+        self._handoff = handoff
+        n = handoff.num_layers
+        if n <= 0:
+            raise ValueError("num_layers must be positive")
+        if not handoff.requests:
+            raise ValueError("migration handoff has no requests")
+        self._num_layers = n
+        self._kv_manager = ShadowKvManager(handoff)
+        self._output_tails: list[list[int]] = [
+            list(r.output_token_ids) for r in handoff.requests
+        ]
+        self._runner = runner
+
+        self._sampling_params: list[ShadowSamplingParams] = [
+            sampling_params_from_wire_dict(r.sampling_params) for r in handoff.requests
+        ]
+
+        self._all_token_ids: list[list[int]] = []
+        for r in handoff.requests:
+            ids: list[int] = []
+            if r.prompt_token_ids is not None:
+                ids.extend(r.prompt_token_ids)
+            ids.extend(r.output_token_ids)
+            self._all_token_ids.append(ids)
+
+        logger.info(
+            "ShadowExecutor migration_id=%s num_layers=%s batch_size=%s",
+            handoff.migration_id,
+            n,
+            handoff.batch_size,
+        )
+
+        self._tkcth_sender: UdsTkcthSenderTransport | None = None
+
+        self._executor_thread: threading.Thread | None = None
+        self._executor_error: BaseException | None = None
+        self._stop_event = threading.Event()
+
+        if len(layer_kv_tensors) != self._num_layers:
+            raise ValueError(
+                f"expected {self._num_layers} layer KV tensors, got "
+                f"{len(layer_kv_tensors)}"
+            )
+        for layer_idx, t in enumerate(layer_kv_tensors):
+            self._kv_manager.register_layer(layer_idx, t)
+
+    # ── Lifecycle ─────────────────────────────────────────────────────
+
+    def start(self) -> None:
+        """Start the decode thread."""
+        if self._executor_thread is not None:
+            raise RuntimeError("ShadowExecutor.start() already called")
+        self._executor_error = None
+        self._stop_event.clear()
+        self._executor_thread = threading.Thread(
+            target=self._run_executor,
+            name="shadow-cpu-decode",
+            daemon=False,
+        )
+        self._executor_thread.start()
+
+    def stop(self) -> None:
+        self._stop_event.set()
+
+    def join(self, timeout: float | None = None) -> None:
+        if self._executor_thread is None:
+            raise RuntimeError("ShadowExecutor.start() was not called")
+        self._executor_thread.join(timeout=timeout)
+        if timeout is not None and self._executor_thread.is_alive():
+            raise TimeoutError("decode thread did not finish within timeout")
+        err = self._executor_error
+        if err is not None:
+            raise err
+
+    # ── Executor ───────────────────────────────────────────────────────
+
+    def _run_executor(self) -> None:
+        try:
+            self._initialize()
+            self._decode_loop()
+            if self._stop_requested():
+                return
+            self._emit_finishes()
+        except BaseException as e:
+            self._executor_error = e
+        finally:
+            self._teardown()
+
+    def _initialize(self) -> None:
+        transport = UdsTkcthSenderTransport()
+        transport.connect(self._handoff.tkcth_ipc_path)
+        self._tkcth_sender = transport
+
+    def _teardown(self) -> None:
+        if self._tkcth_sender is not None:
+            with suppress(OSError):
+                self._tkcth_sender.close()
+            self._tkcth_sender = None
+
+    def _max_decode_token_steps(self) -> int:
+        m = 0
+        for hr in self._handoff.requests:
+            m = max(m, _max_decode_budget(hr))
+        return max(1, m)
+
+    def _stop_requested(self) -> bool:
+        return self._stop_event.is_set()
+
+    def _decode_loop(self) -> None:
+        if self._stop_requested():
+            return
+        kv_accessor = ShadowCpuPagedKvAccessor(self._kv_manager)
+        step_idx = 0
+        nreq = len(self._handoff.requests)
+        active = [True] * nreq
+        max_steps = self._max_decode_token_steps()
+
+        for _ in range(max_steps):
+            if self._stop_requested():
+                return
+
+            # Collect the batch of active requests for this step
+            batch_ri: list[int] = []
+            batch_token_ids: list[int] = []
+            batch_sp: list[ShadowSamplingParams] = []
+            for ri in range(nreq):
+                if not active[ri]:
+                    continue
+                hr = self._handoff.requests[ri]
+                if _remaining_new_tokens(hr, self._output_tails[ri]) <= 0:
+                    active[ri] = False
+                    continue
+                self._kv_manager.prepare_decode_step(ri)
+                past_len = self._kv_manager.num_computed[ri]
+                batch_ri.append(ri)
+                batch_token_ids.append(self._all_token_ids[ri][past_len])
+                batch_sp.append(self._sampling_params[ri])
+
+            if not batch_ri:
+                break
+
+            t0 = time.perf_counter()
+            results = self._runner.generate_step(
+                batch_ri,
+                batch_sp,
+                batch_token_ids,
+                self._kv_manager,
+                kv_accessor,
+            )
+            dt_ms = (time.perf_counter() - t0) * 1000.0
+
+            logger.info(
+                "shadow_cpu_decode migration_id=%s output_token_ids=%s "
+                "step=%s batch_size=%d wall_ms=%.2f",
+                self._handoff.migration_id,
+                [r[0] for r in results],
+                step_idx,
+                len(batch_ri),
+                dt_ms,
+            )
+
+            for idx, ri in enumerate(batch_ri):
+                tid, stopped = results[idx]
+                hr = self._handoff.requests[ri]
+                self._output_tails[ri].append(tid)
+                self._all_token_ids[ri].append(tid)
+                self._emit_single_token_delta(hr.request_id, tid)
+                self._kv_manager.advance_num_computed(ri)
+                if stopped:
+                    active[ri] = False
+
+            step_idx += 1
+
+    # ---- TKCTH emission ----
+
+    def _emit_single_token_delta(
+        self,
+        request_id: str,
+        token_id: int,
+    ) -> None:
+        assert self._tkcth_sender is not None
+        self._tkcth_sender.send(
+            TkcthTokenDelta(
+                migration_id=int(self._handoff.migration_id),
+                request_id=request_id,
+                token_ids=[token_id],
+            )
+        )
+
+    def _emit_finishes(self) -> None:
+        assert self._tkcth_sender is not None
+        mid = int(self._handoff.migration_id)
+        for hr in self._handoff.requests:
+            self._tkcth_sender.send(
+                TkcthFinish(
+                    migration_id=mid,
+                    request_id=hr.request_id,
+                    finish_reason="stop",
+                )
+            )
