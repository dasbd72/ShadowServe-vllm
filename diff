+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Eager CPU decoder for shadow migration (Llama / Qwen2 / Qwen3–style checkpoints)."""
+
+from __future__ import annotations
+
+import logging
+import time
+
+import torch
+
+from vllm.shadow.config.config import ShadowConfig
+from vllm.shadow.models.hf_config import load_shadow_hf_config
+from vllm.shadow.executor.kv_manager import ShadowKvManager
+from vllm.shadow.models.llama import LlamaLikeShadowModel, build_llama_like_model
+from vllm.shadow.models.paged_kv import ShadowCpuPagedKvAccessor
+from vllm.shadow.models.sampling import (
+    ShadowSamplingParams,
+    sample_from_logits,
+    should_stop,
+)
+from vllm.shadow.models.weight_loader import ShadowWeightsLoader
+
+logger = logging.getLogger("vllm.shadow.models.model_runner")
+
+__all__ = ("ShadowModelRunner",)
+
+
+class ShadowModelRunner:
+    """Loads HF weights once, then runs unified forward steps."""
+
+    __slots__ = ("_decoder",)
+
+    def __init__(self, decoder: LlamaLikeShadowModel) -> None:
+        self._decoder = decoder
+
+    @property
+    def eos_token_id(self) -> int | None:
+        return self._decoder.eos_token_id
+
+    @classmethod
+    def load_from_config(cls, shadow_config: ShadowConfig) -> ShadowModelRunner:
+        loader = ShadowWeightsLoader(shadow_config)
+        hf = load_shadow_hf_config(loader.model_dir)
+
+        dtype = shadow_config.dtype
+        if not isinstance(dtype, torch.dtype):
+            raise TypeError("ShadowConfig.dtype must be resolved to torch.dtype")
+
+        t0 = time.perf_counter()
+        weights: dict[str, torch.Tensor] = {}
+        for name, tensor in loader.iter_tensors():
+            weights[name] = tensor.to(
+                dtype=dtype, device=torch.device("cpu")
+            ).contiguous()
+
+        if hf.model_type in (
+            "qwen2",
+            "qwen3",
+            "llama",
+        ):
+            decoder = build_llama_like_model(
+                hf, weights, dtype, block_size=shadow_config.block_size
+            )
+        else:
+            raise ValueError(
+                f"unsupported shadow model_type={hf.model_type!r} "
+                f"(architectures={hf.architectures}); "
+                "supported: llama (incl. Llama 3.x), mistral, stablelm, qwen2, qwen3"
+            )
+
+        del weights
+        elapsed_ms = (time.perf_counter() - t0) * 1000.0
+
+        logger.info(
+            "Shadow CPU model loaded model_type=%s dtype=%s layers=%d time_ms=%.1f",
+            hf.model_type,
+            dtype,
+            hf.num_hidden_layers,
+            elapsed_ms,
+        )
+        return cls(decoder)
+
+    def logits_step(
+        self,
+        request_indices: list[int],
+        query_token_ids_per_req: list[list[int]],
+        kv_manager: ShadowKvManager,
+        kv_accessor: ShadowCpuPagedKvAccessor,
+    ) -> torch.Tensor:
+        """Run one forward step and return float32 logits ``[batch, vocab]``."""
+        return self._decoder.forward_query_logits(
+            request_indices,
+            query_token_ids_per_req,
+            kv_manager,
+            kv_accessor,
+        )
+
+    def generate_step(
+        self,
+        request_indices: list[int],
+        sampling_params: list[ShadowSamplingParams],
+        token_ids: list[int],
+        kv_manager: ShadowKvManager,
+        kv_accessor: ShadowCpuPagedKvAccessor,
+    ) -> list[tuple[int, bool]]:
+        logits = self.logits_step(
+            request_indices,
+            [[t] for t in token_ids],
+            kv_manager,
+            kv_accessor,
+        )
+        out: list[tuple[int, bool]] = []
+        for i in range(logits.size(0)):
+            tid = sample_from_logits(logits[i], sampling_params[i])
+            stopped = should_stop(tid, sampling_params[i], self.eos_token_id)
+            out.append((tid, stopped))
+        return out
